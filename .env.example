# Confirmed canonical origin for this PlayTown website.
# Set empty explicitly for a noindex preview.
NEXT_PUBLIC_SITE_URL=https://playtown.nisimin.com

NEXT_PUBLIC_CONTACT_EMAIL=hello@nisimin.com
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Approved real store listings only; empty values show availability notices.
NEXT_PUBLIC_PLAYTOWN_ANDROID_URL=
NEXT_PUBLIC_PLAYTOWN_IOS_URL=

# Build-time switches; configure independently from runtime secrets.
# Enable only when the Pages Function runtime receiver is configured.
NEXT_PUBLIC_INQUIRIES_ENABLED=false
# Set true in the Cloudflare Preview build environment.
NEXT_PUBLIC_NOINDEX=false
